  "fields": {
    "titulo": "Curriculo Samila",
    "slug": "curriculo-samila",
    "conteudo_html": "<section id=\"curriculo-samila\">\n    <img src=\"/static/portal/img/samila.jpg\" alt=\"Foto de Samila Maria\" title=\"Minha foto\" class=\"foto-curriculo\">\n\n    <p class=\"texto-padrao\"><b>Nome:</b> Samila Maria Pereira Cabral</p>\n    <p class=\"texto-padrao\"><b>Idade:</b> 17 anos</p>\n    <p class=\"texto-padrao\"><b>Experiências:</b> Sem Experiências</p>\n\n    <article>\n        <h3 class=\"titulo-destaque\">OBJETIVO</h3>\n        <p class=\"texto-padrao\">Desenvolver minhas capacidades, cumprir com as atribuições designadas e agregar valores através de um trabalho focado em produtividade, criatividade e responsabilidade.</p>\n    </article>\n\n    <article>\n        <h3 class=\"titulo-destaque\">CONTATO</h3>\n        <p class=\"texto-padrao\">Lagoa do Serrote, Estrela de Alagoas - AL</p>\n        <p class=\"texto-padrao\">(82) 98218-6215</p>\n        <p class=\"texto-padrao\">smpc1@aluno.ifal.edu.br</p>\n    </article>\n\n    <article>\n        <h3 class=\"titulo-destaque\">REDES</h3>\n        <a href=\"https://github.com/samila-maria\" target=\"_blank\" rel=\"noopener noreferrer\" title=\"Acesse meu perfil no GitHub\" class=\"link\">Meu GitHub</a>\n    </article>\n\n    <article>\n        <h3 class=\"titulo-destaque\">HABILIDADES PESSOAIS</h3>\n        <p class=\"texto-padrao\">Capacidade de liderar e motivar equipes.</p>\n        <p class=\"texto-padrao\">Adaptabilidade a novas funções e ambientes.</p>\n        <p class=\"texto-padrao\">Habilidade para se relacionar com diferentes personalidades.</p>\n    </article>\n</section>",
    "ativo": true
  }
},
{
  "model": "portal.conteudo",
  "pk": 3,
  "fields": {
    "titulo": "Tema livre Samila",
    "slug": "tema-livre-samila",
    "conteudo_html": "<section id=\"tema-samila\">\n    <article>\n        <h2 class=\"titulo-destaque\">Léo Foguete: De Porteiro a Estrela</h2>\n        <img src=\"/static/portal/img/leo_foguete.jpg\" alt=\"Foto do cantor Léo Foguete\" title=\"Léo Foguete\" class=\"foto-tema\">\n        <p class=\"texto-padrao\"><i>Léo Foguete, cujo nome verdadeiro é Mayrllon de Castro, é um jovem de Petrolina que virou um fenômeno na música. Antes de ficar famoso, trabalhou como entregador e porteiro.</i></p>\n\n        <h3 class=\"titulo-destaque\">O começo de tudo</h3>\n        <p class=\"texto-padrao\">A música sempre esteve na sua vida. Ganhou seu primeiro violão da avó e começou tocando em barzinhos.</p>\n        <p><a href=\"https://youtu.be/oB8D1TCPoo4\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"link\">Ouça agora um dos seus sucessos no YouTube!</a></p>\n    </article>\n</section>",
    "ativo": true
  }
},
{
  "model": "portal.conteudo",
  "pk": 4,
  "fields": {
    "titulo": "Curriculo Arthur",
    "slug": "curriculo-arthur",
    "conteudo_html": "<section id=\"curriculo-arthur\">\n    <img src=\"/static/portal/img/Arthur_Foto.png\" class=\"foto-curriculo\" alt=\"Foto de Arthur Barbosa\">\n\n    <p class=\"texto-padrao\"><b>Nome:</b> Arthur Barbosa dos Santos</p>\n    <p class=\"texto-padrao\"><b>Idade:</b> 17 anos</p>\n    <p class=\"texto-padrao\"><b>Experiências:</b> Muitíssimas experiências</p>\n\n    <article>\n        <h2 class=\"titulo-destaque\">OBJETIVO</h2>\n        <p class=\"texto-padrao\">Colaborar o máximo possível e progredir na carreira como programador</p>\n    </article>\n\n    <article>\n        <h2 class=\"titulo-destaque\">CONTATO</h2>\n        <p class=\"texto-padrao\">Rua Rosendo Rodrigues, Bairro Vila Maria, Palmeira dos Índios, AL</p>\n        <p class=\"texto-padrao\">(82) 99436-4682</p>\n        <p class=\"texto-padrao\">abs43@aluno.ifal.edu.br</p>\n    </article>\n\n    <article>\n        <h2 class=\"titulo-destaque\">REDES</h2>\n        <a href=\"https://github.com/GreenHackTale\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"link\">Meu github</a>\n        <a href=\"https://www.instagram.com/arthur_barbosa24/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"link\">Meu instagram</a>\n    </article>\n\n    <article>\n        <h3 class=\"titulo-destaque\">HABILIDADES PESSOAIS</h3>\n        <p class=\"texto-padrao\">Adaptabilidade a novas funções e ambientes.</p>\n        <p class=\"texto-padrao\">Inglês médio</p>\n        <p class=\"texto-padrao\">Muito conhecimento técnico em informática</p>\n    </article>\n</section>",
    "ativo": true
  }
},
